{
  "packages": [
    "nodejs@18",
    "python@3.11",
    "rustc@1.74",
    "cargo@1.74",
    "github-cli@2.40.1",
    "kubectl@1.28.4",
    "docker@24.0.7",
    "docker-compose@2.23.3",
    "helm@3.13.3",
    "jq@1.7.1",
    "yq-go@4.40.5",
    "bat@0.24.0",
    "ripgrep@13.0.0",
    "fd@8.7.1",
    "git@2.42.1",
    "git-lfs@3.4.1",
    "curl@8.5.0",
    "openssh@9.5",
    "htop@3.2.2",
    "tree@2.1.1",
    "vim@9.0",
    "nano@7.2"
  ],
  "shell": {
    "init_hook": [
      "echo '🚀 Claude Code development environment initialized with devbox'",
      "echo '📦 Available tools: Node.js, Python, Rust, Docker, Kubernetes, and more'",
      "echo '💡 Run `devbox services` to see available services'",
      "echo '📖 Documentation: https://www.jetpack.io/devbox/docs/'"
    ],
    "scripts": {
      "setup": [
        "echo 'Setting up Claude Code development environment...'",
        "mkdir -p $HOME/workspace/{python,rust,nodejs,docker}",
        "mkdir -p $HOME/projects",
        "mkdir -p $HOME/.claude",
        "echo 'Installing Python development tools...'",
        "pip install --upgrade pip pipenv poetry uv",
        "echo 'Installing Node.js global packages...'",
        "npm install -g yarn pnpm @anthropic-ai/claude-code",
        "echo 'Configuring npm security settings...'",
        "npm config set audit-level moderate",
        "npm config set fund false", 
        "npm config set update-notifier false",
        "echo '✅ Development environment setup completed!'"
      ],
      "verify": [
        "echo '=== Development Environment Verification ==='",
        "echo 'Node.js:' $(node --version)",
        "echo 'npm:' $(npm --version)",
        "echo 'Python:' $(python --version)",
        "echo 'pip:' $(pip --version)",
        "echo 'Rust:' $(rustc --version)",
        "echo 'Cargo:' $(cargo --version)",
        "echo 'Docker:' $(docker --version)",
        "echo 'kubectl:' $(kubectl version --client)",
        "echo 'GitHub CLI:' $(gh --version)",
        "echo '=== Verification completed ==='",
        "echo 'Run `devbox run setup` to complete environment setup'"
      ]
    }
  },
  "env": {
    "NODE_ENV": "development",
    "DOCKER_BUILDKIT": "1",
    "COMPOSE_DOCKER_CLI_BUILD": "1",
    "CLAUDE_CODE_WORKSPACE": "$HOME/workspace",
    "CLAUDE_CODE_PROJECTS": "$HOME/projects",
    "DEBUG": "microservices:*",
    "LOG_LEVEL": "debug",
    "RUST_BACKTRACE": "1",
    "PYTHONPATH": "$HOME/workspace/python:$HOME/projects"
  },
  "nixpkgs": {
    "commit": "4ecab3273592f27479a583fb6d975d4aba3486fe"
  }
}